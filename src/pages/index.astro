---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import RecentPublications from "../components/RecentPublications.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="w-full max-w-screen-md mx-auto my-4 dark:bg-neutral-800 dark:text-neutral-300 transition-colors duration-300" >
    <Header />
    <main class="flex flex-col justify-center">
      <div class="px-4 md:px-16 flex flex-col gap-4 md:my-10">
        <h1 class="text-2xl md:text-5xl w-full">Welcome to the brewlog!</h1>
        <p class="w-full text-justify text-base md:text-lg">
          Hello! I am currently a masters student @ Carnegie Mellon.
          This is where I post notes documenting my learning and exploration of concepts that interest me.
          <br><br>
          Fun fact: I love cold brew :)
        </p>
      </div>
      <div class="w-full flex flex-col items-center gap-2.5 px-4 lg:px-0 mt-6">
        <img src="/photos/home.jpeg"/>
        <p class="italic text-xs text-gray-600 dark:text-neutral-400">
          Photo by me. I lived in Seattle for two years before CMU. I love that place.
        </p>
      </div>
	  <!-- <RecentPublications /> -->
	      </main>
    <Footer />
  </body>
</html>

